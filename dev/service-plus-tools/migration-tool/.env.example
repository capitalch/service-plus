# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
#
# Same Postgres host/port/user/password service-plus-server uses to reach every
# client database (see DESIGN.md §2) — only the database name changes per target,
# and the control database name is entered in the tool's UI, not here.

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
