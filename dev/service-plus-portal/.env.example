# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked into the static site at build time:
# rebuild (pnpm build / deploy script) after changing them, and restart pnpm dev.
# Required: NEXT_PUBLIC_CONTACT_EMAIL, NEXT_PUBLIC_CONTACT_PHONE, NEXT_PUBLIC_SITE_URL. The build fails without them.

# service-plus-server the enquiry form posts to, and the key it expects (WEBSITE_API_KEY on the server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEBSITE_KEY=
# Service+ app the Login button opens (defaults to https://serviceplus.cloudjiffy.net)
NEXT_PUBLIC_APP_URL=

# Public site URL, used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://myserviceplus.in

# Contacts. Phone is the display form; tel: and wa.me links are derived from its digits.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=+91 XXXXX XXXXX
# Optional: only when the WhatsApp number differs from the phone
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Optional: defaults to "Mon–Sat, 10:00 AM – 7:00 PM IST"
NEXT_PUBLIC_BUSINESS_HOURS=

# Optional address for the contact page and footer; city, state and country default to Kolkata, West Bengal, India.
# Map URL defaults to a Google Maps search for the address.
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_COUNTRY=
NEXT_PUBLIC_ADDRESS_LINE1=
NEXT_PUBLIC_ADDRESS_LINE2=
NEXT_PUBLIC_ADDRESS_MAP_URL=
NEXT_PUBLIC_ADDRESS_PINCODE=
NEXT_PUBLIC_ADDRESS_STATE=

# Optional bank details for the enquiry success card; shown only when account number and IFSC are both set
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BRANCH=
NEXT_PUBLIC_BANK_IFSC=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_UPI_ID=
