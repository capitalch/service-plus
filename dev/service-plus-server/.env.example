# Copy this file to `.env` and fill in real values.
# This file documents every environment variable the app reads — names only, no real values.
# `.env` itself is gitignored (see repo-root .gitignore) and must never be committed.

# --- Runtime environment ---
# Read directly via os.environ.get("APP_ENV", ...) in app/config.py, app/db/pool_manager.py,
# app/db/psycopg_driver.py, and app/routers/image_router.py (not a pydantic Settings field yet).
# "development" or "production".
APP_ENV=development

# --- Application Settings ---
APP_NAME=
APP_VERSION=
DEBUG=
HOST=
PORT=
UPLOAD_BASE_DIR=

# --- File Server Settings ---
FILE_SERVER_URL_DEVELOPMENT=
FILE_SERVER_URL_PRODUCTION=
FILE_SERVER_API_KEY=

# --- Public website (service-plus-web) settings ---
# Sent by service-plus-web as the X-Website-Key header on every /api/public/* call.
# Must match service-plus-web's NEXT_PUBLIC_WEBSITE_KEY.
WEBSITE_API_KEY=

# --- GraphQL Settings ---
GRAPHQL_PATH=
GRAPHQL_PLAYGROUND=

# --- Client Database Settings ---
CLIENT_DB_HOST=
CLIENT_DB_PORT=
CLIENT_DB_NAME=
CLIENT_DB_USER=
CLIENT_DB_PASSWORD=
CLIENT_DB_IP_ADDRESS=
CLIENT_DB_INTERNAL_PORT=

# --- Service Database Settings ---
SERVICE_DB_HOST=
SERVICE_DB_PORT=
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=
SERVICE_DB_IP_ADDRESS=
SERVICE_DB_INTERNAL_PORT=

# --- Security Settings ---
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Logging Settings ---
LOG_LEVEL=
LOG_FORMAT=

# --- SMTP Settings ---
SMTP_HOST=
SMTP_FROM=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
# Recipient for kush-infotech-web contact-form submissions (POST /api/public/contact).
# Optional — leave unset to have that endpoint return 503 "not configured".
CONTACT_NOTIFY_EMAIL=

# --- Audit log settings ---
AUDIT_LOG_DIR=
AUDIT_LOG_MAX_READ_DAYS=
AUDIT_LOG_RETENTION_DAYS=

# --- trace-plus accounts integration ---
TRACE_PLUS_URL_DEVELOPMENT=
TRACE_PLUS_URL_PRODUCTION=
TRACE_PLUS_SERVICE_KEY=

# --- WhatsApp Cloud API (Meta, direct) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# System User permanent token — NOT the 24 hours API Setup token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Dedicated secret for signing job-intake status-link tokens — not WHATSAPP_APP_SECRET
WHATSAPP_LINK_TOKEN_SECRET=
# Dedicated secret for hashing job-delivery confirmation codes — not WHATSAPP_LINK_TOKEN_SECRET
WHATSAPP_DELIVERY_OTP_SECRET=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# --- Super admin ---
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_MOBILE=
