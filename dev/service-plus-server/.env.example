# Copy this file to `.env` and fill in real values.
# This file documents every environment variable the app reads — names only, no real values.
# `.env` itself is gitignored (see repo-root .gitignore) and must never be committed.

# --- Runtime environment ---
# Read directly via os.environ.get("APP_ENV", ...) in app/config.py, app/db/pool_manager.py,
# app/db/psycopg_driver.py, and app/routers/image_router.py (not a pydantic Settings field yet).
# "development" or "production".
APP_ENV=development

# --- Application Settings ---
APP_NAME=
APP_VERSION=
DEBUG=
HOST=
PORT=
UPLOAD_BASE_DIR=

# --- File Server Settings ---
FILE_SERVER_URL_DEVELOPMENT=
FILE_SERVER_URL_PRODUCTION=
FILE_SERVER_API_KEY=

# --- Public website (service-plus-web) settings ---
# Sent by service-plus-web as the X-Website-Key header on every /api/public/* call.
# Must match service-plus-web's NEXT_PUBLIC_WEBSITE_KEY.
WEBSITE_API_KEY=

# --- GraphQL Settings ---
GRAPHQL_PATH=
GRAPHQL_PLAYGROUND=

# --- Client Database Settings ---
CLIENT_DB_HOST=
CLIENT_DB_PORT=
CLIENT_DB_NAME=
CLIENT_DB_USER=
CLIENT_DB_PASSWORD=
CLIENT_DB_IP_ADDRESS=
# The DB's own port inside its host network, not the externally reachable one above —
# standard Postgres default, same for every deployment.
CLIENT_DB_INTERNAL_PORT=5432

# --- Service Database Settings ---
SERVICE_DB_HOST=
SERVICE_DB_PORT=
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=
SERVICE_DB_IP_ADDRESS=
SERVICE_DB_INTERNAL_PORT=5432

# --- Security Settings ---
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Logging Settings ---
LOG_LEVEL=
LOG_FORMAT=

# --- SMTP Settings ---
SMTP_HOST=
SMTP_FROM=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
# Recipient for kush-infotech-web contact-form submissions (POST /api/public/contact).
# Optional — leave unset to have that endpoint return 503 "not configured".
CONTACT_NOTIFY_EMAIL=

# --- Audit log settings ---
AUDIT_LOG_DIR=
AUDIT_LOG_MAX_READ_DAYS=
AUDIT_LOG_RETENTION_DAYS=

# --- trace-plus accounts integration ---
TRACE_PLUS_URL_DEVELOPMENT=
TRACE_PLUS_URL_PRODUCTION=
TRACE_PLUS_SERVICE_KEY=

# --- WhatsApp Cloud API (Meta, direct) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# System User permanent token — NOT the 24 hours API Setup token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Dedicated secret for signing job-intake status-link tokens — not WHATSAPP_APP_SECRET
WHATSAPP_LINK_TOKEN_SECRET=
# Dedicated secret for hashing job-delivery confirmation codes — not WHATSAPP_LINK_TOKEN_SECRET
WHATSAPP_DELIVERY_OTP_SECRET=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# --- Super admin ---
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_MOBILE=

# --- Customer settings (subscription plans) ---
# The tenant database that holds Lite, Basic and Standard customers, one business unit each.
# Must match the db_name of an active client row that has an admin user.
# Leave empty to switch the sign-up and enquiry-approval features off.
DEFAULT_CUSTOMER_DB_NAME=
# Optional — extra recipient for "new enquiry awaiting approval" emails (Lite/Basic/Standard).
# The admin users of the default customer database are always notified.
LITE_BASIC_STANDARD_ENQUIRY_NOTIFY_EMAIL=
# Optional — recipient for Enterprise enquiries. Falls back to CONTACT_NOTIFY_EMAIL, then SUPER_ADMIN_EMAIL.
ENTERPRISE_ENQUIRY_NOTIFY_EMAIL=
# Optional — hour of day (0-23, India time) the daily payment-reminder job runs. Default 9.
BILLING_REMINDER_HOUR=9
# Plan prices, in whole rupees. Lite is always free. This is the only place prices live: the
# portal fetches them live from GET /api/public/plan-prices, so a change needs only a server restart.
PRICE_BASIC_SETUP=
PRICE_BASIC_MONTHLY=
PRICE_STANDARD_SETUP=
PRICE_STANDARD_MONTHLY=
PRICE_ENTERPRISE_SETUP=
PRICE_ENTERPRISE_MONTHLY=
# Enterprise includes this many business units; each one beyond it adds PRICE_EXTRA_BU_MONTHLY.
ENTERPRISE_INCLUDED_BUS=5
PRICE_EXTRA_BU_MONTHLY=3000
# Usage limits
LIMIT_LITE_JOBS=
LIMIT_LITE_WHATSAPP=
LIMIT_BASIC_JOBS=
LIMIT_BASIC_WHATSAPP=
LIMIT_STANDARD_JOBS=
LIMIT_STANDARD_WHATSAPP=
LIMIT_ENTERPRISE_JOBS=
LIMIT_ENTERPRISE_WHATSAPP=

# --- Ask AI in the client Help Center (app/ai_help/) ---
# Gemini API key from aistudio.google.com. Leave empty to hide Ask AI.
GEMINI_API_KEY=
# Only "gemini" is built; another provider means a new file in app/ai_help/providers/.
AI_HELP_PROVIDER=gemini
# Main model, and the one tried once when the main one hits its free quota (empty = none).
AI_HELP_MODEL=gemini-3.8-flash
AI_HELP_FALLBACK_MODEL=gemini-3.5-flash-lite
# In-memory limits; a server restart resets them.
AI_HELP_DAILY_LIMIT_PER_BU=30
AI_HELP_PER_USER_PER_MINUTE=5
# Portal address used for links in sign-up emails (status page).
# Ignored while DEBUG is on: links then use   http://localhost:3005.
PORTAL_URL_PRODUCTION=https://serviceplus.cloudjiffy.net
# --- Live demo from the portal (app/core/settings/demo_settings.py) ---
# Leave DEMO_DB_NAME or DEMO_BU_CODE empty for no demo. The demo business unit is read-only for
# everyone except the Super Admin, and never sends WhatsApp or email.
DEMO_DB_NAME=
DEMO_BU_CODE=
# Business user every visitor of <app address>/demo is signed in as (not an admin).
DEMO_USERNAME=
# true lets visitors save (only with a nightly reset). Keep false for the read-only demo.
DEMO_WRITABLE=false
